{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "rules": { "typescript/no-explicit-any": "error", "no-unused-vars": "error" },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/.next-production/**",
    "**/next-env.d.ts",
    "**/drizzle/meta/**"
  ]
}
