{
  "name": "@jobs/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/tests/unit.test.js dist/tests/resumes.test.js",
    "test:integration": "tsc && node --test dist/tests/integration.test.js dist/tests/resumes.integration.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "jose": "6.2.16",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "typescript": "~5.9.3"
  }
}
